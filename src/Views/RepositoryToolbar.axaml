<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceFork.Models"
             xmlns:vm="using:SourceFork.ViewModels"
             xmlns:c="using:SourceFork.Converters"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceFork.Views.RepositoryToolbar"
             x:DataType="vm:Repository">
  <UserControl.Resources>
    <DataTemplate x:Key="ToolbarActionTemplate" DataType="vm:RepositoryToolbarAction">
      <Panel>
        <Button Classes="icon_button"
                Width="32"
                IsVisible="{Binding !IsToggle}"
                IsEnabled="{Binding IsEnabled}"
                Tapped="OnToolbarActionTapped">
          <ToolTip.Tip>
            <StackPanel Orientation="Vertical">
              <TextBlock Text="{Binding Tooltip}"/>
              <TextBlock Classes="small italic"
                         Margin="0,4,0,0"
                         Foreground="{DynamicResource Brush.FG2}"
                         IsVisible="{Binding HasHint}"
                         Text="{Binding Hint}"/>
            </StackPanel>
          </ToolTip.Tip>

          <Panel>
            <Path Width="14" Height="14" Data="{Binding Icon}"/>
            <Ellipse Width="8" Height="8"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{DynamicResource Brush.Badge}"
                     IsVisible="{Binding ShowBadge}"/>
          </Panel>
        </Button>

        <ToggleButton Classes="line_path"
                      Width="28"
                      IsVisible="{Binding IsToggle}"
                      IsChecked="{Binding IsToggled, Mode=OneWay}"
                      Click="OnToggleToolbarAction"
                      ToolTip.Tip="{Binding Tooltip}">
          <Path Width="13" Height="13" Data="{Binding Icon}"/>
        </ToggleButton>
      </Panel>
    </DataTemplate>
  </UserControl.Resources>

  <Grid ColumnDefinitions="*,Auto,*">
    <StackPanel Grid.Column="0" Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
      <ItemsControl x:Name="LeftActions"
                    ItemTemplate="{StaticResource ToolbarActionTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Button x:Name="LeftMoreButton"
              Classes="icon_button"
              Width="32"
              Margin="4,0,0,0"
              Tag="LeftMore"
              IsVisible="False"
              Click="OnOpenMoreActions"
              ToolTip.Tip="{DynamicResource Text.Repository.MoreOptions}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
      </Button>
    </StackPanel>

    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
      <ItemsControl x:Name="MiddleActions"
                    ItemTemplate="{StaticResource ToolbarActionTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Button x:Name="MoreButton"
              Classes="icon_button"
              Width="32"
              Margin="4,0,0,0"
              Tag="MiddleMore"
              IsVisible="False"
              Click="OnOpenMoreActions"
              ToolTip.Tip="{DynamicResource Text.Repository.MoreOptions}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
      </Button>

      <Button Width="0" Height="0" Click="PushDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Shift+Up, macOS=⌘+Shift+Up}"/>
      <Button Width="0" Height="0" Click="PullDirectlyByHotKey" IsVisible="False" IsEnabled="{Binding !IsBare}" HotKey="{OnPlatform Ctrl+Shift+Down, macOS=⌘+Shift+Down}"/>
      <Button Width="0" Height="0" Click="FetchDirectlyByHotKey" IsVisible="False" HotKey="{OnPlatform Ctrl+Down, macOS=⌘+Down}"/>
    </StackPanel>

    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
      <ItemsControl x:Name="RightActions"
                    ItemTemplate="{StaticResource ToolbarActionTemplate}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>

      <Button x:Name="RightMoreButton"
              Classes="icon_button"
              Width="32"
              Margin="4,0,0,0"
              Tag="RightMore"
              IsVisible="False"
              Click="OnOpenMoreActions"
              ToolTip.Tip="{DynamicResource Text.Repository.MoreOptions}">
        <Path Width="14" Height="14" Data="{StaticResource Icons.More}"/>
      </Button>

      <Path Width="13" Height="13" Fill="{DynamicResource Brush.FG1}" Data="{StaticResource Icons.Branch}"/>

      <ContentControl Margin="6,0,0,0">
        <ContentControl.Content>
          <Binding Path="CurrentBranch">
            <Binding.TargetNullValue>
              <TextBlock Text="--"/>
            </Binding.TargetNullValue>
          </Binding>
        </ContentControl.Content>

        <ContentControl.DataTemplates>
          <DataTemplate DataType="m:Branch">
            <Border Background="Transparent" ToolTip.Tip="{Binding FriendlyName}">
              <TextBlock Text="{Binding FriendlyName}" MaxWidth="250" TextTrimming="CharacterEllipsis"/>
            </Border>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>

      <Button Classes="icon_button" Width="32" Click="NavigateToHead" ToolTip.Tip="{DynamicResource Text.Repository.NavigateToCurrentHead}">
        <Path Width="13" Height="13" Margin="0,2,0,0" Data="{StaticResource Icons.Target}" Fill="{DynamicResource Brush.FG1}"/>
      </Button>
    </StackPanel>
  </Grid>
</UserControl>
