<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:SourceFork.ViewModels"
                    xmlns:v="using:SourceFork.Views"
                    mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="620"
                    x:Class="SourceFork.Views.RepositoryHistory"
                    x:DataType="vm:RepositoryHistory"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.RepositoryHistory.Title}"
                    Width="760" Height="620"
                    MinWidth="640" MinHeight="480"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Clean}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.RepositoryHistory.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <StackPanel Grid.Row="1" Margin="16,12,16,8">
      <StackPanel Orientation="Horizontal">
        <Path Width="18" Height="18" Data="{StaticResource Icons.Clean}" Fill="{DynamicResource Brush.FG1}"/>
        <TextBlock Margin="8,0,0,0"
                   Classes="bold"
                   FontSize="16"
                   Text="{DynamicResource Text.RepositoryHistory.Title}"/>
      </StackPanel>
      <TextBlock Margin="0,6,0,0"
                 Foreground="{DynamicResource Brush.FG2}"
                 TextWrapping="Wrap"
                 Text="{DynamicResource Text.RepositoryHistory.Description}"/>
    </StackPanel>

    <Grid Grid.Row="2" Margin="16,0,16,8" RowDefinitions="Auto,2.5*,Auto,1.5*">
      <TextBox Grid.Row="0"
               Height="30"
               Padding="0"
               CornerRadius="6"
               BorderBrush="{DynamicResource Brush.Border2}"
               BorderThickness="1"
               Background="{DynamicResource Brush.Contents}"
               PlaceholderText="{DynamicResource Text.RepositoryHistory.Search}"
               Text="{Binding SearchFilter, Mode=TwoWay}">
        <TextBox.InnerLeftContent>
          <Path Width="14" Height="14" Margin="8,0,4,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
        </TextBox.InnerLeftContent>
      </TextBox>

      <Border Grid.Row="1"
              Margin="0,8,0,0"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}">
        <Grid RowDefinitions="Auto,*">
          <Grid Grid.Row="0" Margin="10,8" ColumnDefinitions="*,Auto">
            <TextBlock Text="{DynamicResource Text.RepositoryHistory.Repositories}" FontWeight="Bold"/>
            <TextBlock Grid.Column="1"
                       Text="{Binding RepositoryCount}"
                       Foreground="{DynamicResource Brush.FG2}"/>
          </Grid>
          <Rectangle Grid.Row="0" Height="1" VerticalAlignment="Bottom" Fill="{DynamicResource Brush.Border2}"/>

          <ScrollViewer Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
            <Panel>
              <ItemsControl ItemsSource="{Binding Repositories}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:RepositoryHistoryItem">
                    <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}" Padding="10,6">
                      <Grid ColumnDefinitions="Auto,*,Auto">
                        <Path Grid.Column="0"
                              Width="14" Height="14"
                              Margin="0,2,8,0"
                              VerticalAlignment="Top"
                              Data="{StaticResource Icons.Repositories}"
                              Fill="{DynamicResource Brush.FG1}"/>
                        <StackPanel Grid.Column="1">
                          <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                            <Border Height="16"
                                    Margin="8,0,0,0"
                                    Padding="6,0"
                                    CornerRadius="8"
                                    Background="{DynamicResource Brush.Badge}"
                                    VerticalAlignment="Center"
                                    IsVisible="{Binding HasTags}">
                              <TextBlock Text="{DynamicResource Text.RepositoryHistory.Tagged}"
                                         FontSize="10"
                                         Foreground="{DynamicResource Brush.BadgeFG}"/>
                            </Border>
                          </StackPanel>
                          <TextBlock FontSize="10"
                                     Foreground="{DynamicResource Brush.FG2}"
                                     Text="{Binding Path}"
                                     TextTrimming="CharacterEllipsis"
                                     ToolTip.Tip="{Binding Path}"/>
                          <TextBlock FontSize="10"
                                     Foreground="{DynamicResource Brush.FG2}"
                                     Text="{Binding SourceText}"
                                     TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <Button Grid.Column="2"
                                Classes="flat"
                                Height="26"
                                Padding="10,0"
                                VerticalAlignment="Center"
                                Content="{Binding ActionText}"
                                Click="OnExclude"/>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <TextBlock Margin="10"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{DynamicResource Text.RepositoryHistory.Empty}"
                         IsVisible="{Binding IsEmpty}"/>
            </Panel>
          </ScrollViewer>
        </Grid>
      </Border>

      <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal">
          <TextBlock Text="{DynamicResource Text.RepositoryHistory.Excluded}" FontWeight="Bold"/>
          <Border Height="16"
                  Margin="8,0,0,0"
                  Padding="6,0"
                  CornerRadius="8"
                  Background="{DynamicResource Brush.Badge}"
                  VerticalAlignment="Center"
                  IsVisible="{Binding HasHidden}">
            <TextBlock Text="{Binding HiddenCount}"
                       FontSize="10"
                       Foreground="{DynamicResource Brush.BadgeFG}"/>
          </Border>
        </StackPanel>

        <Button Grid.Column="1"
                Classes="flat"
                Height="26"
                Padding="10,0"
                Click="OnRestoreAll"
                IsEnabled="{Binding HasHidden}">
          <StackPanel Orientation="Horizontal">
            <Path Width="11" Height="11" Data="{StaticResource Icons.Undo}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.RepositoryHistory.RestoreAll}"/>
          </StackPanel>
        </Button>
      </Grid>

      <Border Grid.Row="3"
              Margin="0,6,0,0"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              Background="{DynamicResource Brush.Contents}">
        <Panel>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding HiddenRepositories}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RepositoryHistoryItem">
                  <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}" Padding="10,6">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                      <Path Grid.Column="0"
                            Width="14" Height="14"
                            Margin="0,2,8,0"
                            VerticalAlignment="Top"
                            Data="{StaticResource Icons.HiddenSymbol}"
                            Fill="{DynamicResource Brush.FG2}"/>
                      <StackPanel Grid.Column="1">
                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   Text="{Binding Path}"
                                   TextTrimming="CharacterEllipsis"
                                   ToolTip.Tip="{Binding Path}"/>
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   Text="{Binding SourceText}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>
                      <Button Grid.Column="2"
                              Classes="flat"
                              Height="26"
                              Padding="10,0"
                              VerticalAlignment="Center"
                              Content="{DynamicResource Text.RepositoryHistory.Restore}"
                              Click="OnRestore"/>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Margin="10"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.RepositoryHistory.NoExcluded}"
                     IsVisible="{Binding IsHiddenEmpty}"/>
        </Panel>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="16,0,16,16" ColumnDefinitions="*,Auto">
      <TextBlock Grid.Column="0"
                 VerticalAlignment="Center"
                 Foreground="{DynamicResource Brush.FG2}"
                 Text="{Binding Status}"
                 TextTrimming="CharacterEllipsis"/>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Classes="flat"
                Height="28"
                Padding="12,0"
                Click="OnCleanUnknown"
                IsEnabled="{Binding CanCleanUnknown}">
          <StackPanel Orientation="Horizontal">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Clean}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.RepositoryHistory.CleanUnknown}"/>
          </StackPanel>
        </Button>

        <Button Classes="flat"
                Height="28"
                Padding="12,0"
                Margin="8,0,0,0"
                Click="OnExcludeAll"
                IsEnabled="{Binding CanExcludeAll}">
          <StackPanel Orientation="Horizontal">
            <Path Width="12" Height="12" Data="{StaticResource Icons.RemoveAll}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.RepositoryHistory.ExcludeAll}"/>
          </StackPanel>
        </Button>

        <Button Classes="flat primary"
                Width="100" Height="28"
                Margin="8,0,0,0"
                Content="{DynamicResource Text.RepositoryHistory.Close}"
                Click="OnClose"/>
      </StackPanel>
    </Grid>
  </Grid>
</v:ChromelessWindow>
