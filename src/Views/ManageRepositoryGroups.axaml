<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:vm="using:SourceFork.ViewModels"
                    xmlns:v="using:SourceFork.Views"
                    mc:Ignorable="d" d:DesignWidth="760" d:DesignHeight="600"
                    x:Class="SourceFork.Views.ManageRepositoryGroups"
                    x:DataType="vm:ManageRepositoryGroups"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    Title="{DynamicResource Text.RepositoryGroups.Title}"
                    Width="760" Height="600"
                    MinWidth="660" MinHeight="420"
                    CanResize="True"
                    WindowStartupLocation="CenterOwner">
  <Grid RowDefinitions="Auto,*,Auto">
    <!-- TitleBar -->
    <Grid Grid.Row="0" Height="28" IsVisible="{Binding !#ThisControl.UseSystemWindowFrame}">
      <Border Background="{DynamicResource Brush.TitleBar}"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              PointerPressed="BeginMoveWindow"/>

      <Path Width="14" Height="14"
            Margin="10,0,0,0"
            HorizontalAlignment="Left"
            Data="{StaticResource Icons.Tags}"
            IsVisible="{OnPlatform True, macOS=False}"/>

      <TextBlock Classes="bold"
                 Text="{DynamicResource Text.RepositoryGroups.Title}"
                 HorizontalAlignment="Center" VerticalAlignment="Center"
                 IsHitTestVisible="False"/>

      <v:CaptionButtons HorizontalAlignment="Right"
                        IsCloseButtonOnly="True"
                        IsVisible="{OnPlatform True, macOS=False}"/>
    </Grid>

    <Grid Grid.Row="1" Margin="16,12,16,8" RowDefinitions="Auto,Auto,Auto,*">
      <StackPanel Grid.Row="0" Orientation="Horizontal">
        <Path Width="16" Height="16"
              Margin="0,0,8,0"
              Data="{StaticResource Icons.Tags}"/>

        <TextBlock FontSize="18"
                   Classes="bold"
                   Text="{DynamicResource Text.RepositoryGroups.Title}"/>
      </StackPanel>

      <TextBlock Grid.Row="1"
                 Margin="0,12,0,0"
                 FontSize="11"
                 Foreground="{DynamicResource Brush.FG2}"
                 TextWrapping="Wrap"
                 Text="{DynamicResource Text.RepositoryGroups.Hint}"/>

      <Grid Grid.Row="2" Margin="0,12,0,0" ColumnDefinitions="Auto,Auto,Auto,*">
        <TextBlock VerticalAlignment="Center"
                   FontSize="12"
                   Text="{DynamicResource Text.RepositoryGroups.GroupOrder}"/>

        <ComboBox Grid.Column="1"
                  Margin="8,0,0,0"
                  MinWidth="150"
                  Height="28"
                  VerticalAlignment="Center"
                  ItemsSource="{Binding GroupSortOptions}"
                  SelectedItem="{Binding SelectedGroupSortOption, Mode=TwoWay}">
          <ComboBox.ItemTemplate>
            <DataTemplate DataType="vm:RepositoryGroupSortOption">
              <TextBlock Text="{Binding Label}"/>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <CheckBox Grid.Column="2"
                  Margin="8,0,0,0"
                  VerticalAlignment="Center"
                  FontSize="12"
                  Content="{DynamicResource Text.RepositorySort.Descending}"
                  IsChecked="{Binding GroupSortDescending, Mode=TwoWay}"
                  IsEnabled="{Binding CanReverseGroupSort}"/>
      </Grid>

      <Border Grid.Row="3"
              Margin="0,12,0,0"
              Background="{DynamicResource Brush.Contents}"
              BorderThickness="1"
              BorderBrush="{DynamicResource Brush.Border2}"
              CornerRadius="4">
        <Panel>
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding Groups}">
              <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:RepositoryGroupSetting">
                  <Grid Height="40"
                        Margin="4,1"
                        ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto,Auto">
                    <CheckBox Grid.Column="0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsVisible, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Text.RepositoryGroups.Visible}"/>

                    <TextBlock Grid.Column="1"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding DisplayName}"
                               TextTrimming="CharacterEllipsis"/>

                    <TextBlock Grid.Column="2"
                               Margin="8,0"
                               VerticalAlignment="Center"
                               FontSize="11"
                               Foreground="{DynamicResource Brush.FG2}"
                               Text="{Binding CountText}"/>

                    <ComboBox Grid.Column="3"
                              MinWidth="110"
                              Height="26"
                              Margin="4,0,0,0"
                              VerticalAlignment="Center"
                              ItemsSource="{Binding SortOptions}"
                              SelectedItem="{Binding SelectedSortOption, Mode=TwoWay}">
                      <ComboBox.ItemTemplate>
                        <DataTemplate DataType="vm:RepositorySortOption">
                          <TextBlock Text="{Binding Label}"/>
                        </DataTemplate>
                      </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox Grid.Column="4"
                              Margin="6,0,0,0"
                              VerticalAlignment="Center"
                              FontSize="11"
                              Content="{DynamicResource Text.RepositorySort.Descending}"
                              IsChecked="{Binding SortDescending, Mode=TwoWay}"
                              IsEnabled="{Binding CanReverseSort}"/>

                    <Button Grid.Column="5"
                            Classes="icon_button"
                            Width="24" Height="24"
                            Padding="0"
                            Click="OnMoveUp"
                            ToolTip.Tip="{DynamicResource Text.RepositoryTags.MoveUp}">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Up}"/>
                    </Button>

                    <Button Grid.Column="6"
                            Classes="icon_button"
                            Width="24" Height="24"
                            Padding="0"
                            Click="OnMoveDown"
                            ToolTip.Tip="{DynamicResource Text.RepositoryTags.MoveDown}">
                      <Path Width="12" Height="12" Data="{StaticResource Icons.Down}"/>
                    </Button>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ScrollViewer>

          <TextBlock Margin="16"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.RepositoryGroups.Empty}"
                     IsVisible="{Binding !HasGroups}"/>
        </Panel>
      </Border>
    </Grid>

    <Grid Grid.Row="2" Margin="16,0,16,12" ColumnDefinitions="*,Auto">
      <Button Grid.Column="1"
              Classes="flat primary"
              Width="100" Height="28"
              Padding="0"
              HorizontalContentAlignment="Center"
              VerticalContentAlignment="Center"
              Content="{DynamicResource Text.RepositoryTags.Done}"
              Click="OnDone"/>
    </Grid>
  </Grid>
</v:ChromelessWindow>
