<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceFork.Converters"
             xmlns:vm="using:SourceFork.ViewModels"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceFork.Views.ScanRepositories"
             x:DataType="vm:ScanRepositories">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="8">
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal">
        <Path Width="16" Height="16" Data="{StaticResource Icons.Scan}"/>
        <TextBlock Margin="8,0,0,0"
                   Classes="bold"
                   FontSize="16"
                   Text="{DynamicResource Text.ScanFolders.Title}"/>
      </StackPanel>

      <Button Grid.Column="1"
              Classes="flat"
              Height="28"
              Padding="12,0"
              Click="OnCleanHistory">
        <StackPanel Orientation="Horizontal">
          <Path Width="12" Height="12" Data="{StaticResource Icons.Clean}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.RepositoryHistory.Open}"/>
        </StackPanel>
      </Button>
    </Grid>

    <TextBlock Grid.Row="1"
               Margin="0,6,0,12"
               Foreground="{DynamicResource Brush.FG2}"
               TextWrapping="Wrap"
               Text="{DynamicResource Text.ScanFolders.Description}"/>

    <Border Grid.Row="2"
            BorderThickness="1"
            BorderBrush="{DynamicResource Brush.Border2}"
            Background="{DynamicResource Brush.Contents}">
      <Grid RowDefinitions="*,Auto">
        <ScrollViewer Grid.Row="0"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto">
          <ItemsControl ItemsSource="{Binding Folders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ScanFolderItem">
                <Border BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border2}">
                  <Grid Margin="8,8" ColumnDefinitions="*,112,146,30,30">
                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Path, Converter={x:Static c:PathConverters.RelativeToHome}}"
                                 TextTrimming="CharacterEllipsis"
                                 ToolTip.Tip="{Binding Path}"/>
                    </StackPanel>

                    <ComboBox Grid.Column="1"
                              Height="28"
                              Margin="4,0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding DepthOptions}"
                              SelectedIndex="{Binding DepthIndex, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Text.ScanFolders.Depth}"/>

                    <ComboBox Grid.Column="2"
                              Height="28"
                              Margin="4,0"
                              VerticalAlignment="Center"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding ModeOptions}"
                              SelectedIndex="{Binding ModeIndex, Mode=TwoWay}"
                              ToolTip.Tip="{DynamicResource Text.ScanFolders.Mode}"/>

                    <Button Grid.Column="3"
                            Classes="icon_button"
                            Width="28" Height="28"
                            VerticalAlignment="Center"
                            Click="OnScanFolder"
                            ToolTip.Tip="{DynamicResource Text.ScanFolders.ScanNow}">
                      <Path Width="14" Height="14" Data="{StaticResource Icons.Scan}" Fill="{DynamicResource Brush.FG1}"/>
                    </Button>

                    <Button Grid.Column="4"
                            Classes="icon_button"
                            Width="28" Height="28"
                            VerticalAlignment="Center"
                            Click="OnRemoveFolder"
                            ToolTip.Tip="{DynamicResource Text.ScanFolders.Remove}">
                      <Path Width="10" Height="10" Data="{StaticResource Icons.Minus}" Fill="{DynamicResource Brush.FG1}"/>
                    </Button>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Margin="8"
                    Orientation="Horizontal">
          <Button Classes="flat"
                  Height="28"
                  Click="OnAddFolder">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Data="{StaticResource Icons.Plus}" Fill="{DynamicResource Brush.FG1}"/>
              <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.ScanFolders.Add}"/>
            </StackPanel>
          </Button>

          <TextBlock Margin="12,0,0,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.FG2}"
                     Text="{DynamicResource Text.ScanFolders.Empty}"
                     IsVisible="{Binding IsEmpty}"/>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="3" Margin="0,10,0,0" ColumnDefinitions="*,Auto">
      <StackPanel Grid.Column="0" VerticalAlignment="Center">
        <TextBlock Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding Status}"
                   IsVisible="{Binding Status, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
        <TextBlock Foreground="{DynamicResource Brush.FG2}"
                   Text="{Binding ProgressDescription}"
                   TextTrimming="CharacterEllipsis"
                   IsVisible="{Binding IsScanning}"/>
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal">
        <Button Classes="flat"
                Height="28"
                Padding="16,0"
                Click="OnCancelScan"
                IsVisible="{Binding IsScanning}">
          <StackPanel Orientation="Horizontal">
            <Path Width="10" Height="10" Data="{StaticResource Icons.Close}" Fill="{DynamicResource Brush.FG1}"/>
            <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.ScanFolders.Cancel}"/>
          </StackPanel>
        </Button>

        <Button Classes="flat primary"
                Height="28"
                Padding="16,0"
                Click="OnScanAll"
                IsVisible="{Binding !IsScanning}">
          <StackPanel Orientation="Horizontal">
            <Path Width="12" Height="12" Data="{StaticResource Icons.Scan}" Fill="{DynamicResource AccentButtonForeground}"/>
            <TextBlock Margin="6,0,0,0" Text="{DynamicResource Text.ScanFolders.ScanAll}"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>
