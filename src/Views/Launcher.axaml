<v:ChromelessWindow xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:s="using:SourceFork"
                    xmlns:vm="using:SourceFork.ViewModels"
                    xmlns:v="using:SourceFork.Views"
                    xmlns:c="using:SourceFork.Converters"
                    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
                    x:Class="SourceFork.Views.Launcher"
                    x:DataType="vm:Launcher"
                    x:Name="ThisControl"
                    Icon="/App.ico"
                    DragDrop.AllowDrop="True"
                    MinWidth="1024" MinHeight="600">
  <v:ChromelessWindow.Title>
    <MultiBinding Converter="{x:Static c:StringConverters.ToWindowTitle}">
      <Binding Path="ActivePage?.Node.Name" Mode="OneWay"/>
    </MultiBinding>
  </v:ChromelessWindow.Title>
  <Grid DragDrop.AllowDrop="True">
    <Grid.RowDefinitions>
      <RowDefinition Height="{Binding #ThisControl.CaptionHeight}"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom TitleBar -->
    <Grid Grid.Row="0">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.VisibleWorkspaceSidebarWidth, Mode=OneWay}"/>
        <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarSplitterWidth, Mode=OneWay}"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <!-- Bottom border -->
      <Border Grid.Column="0" Grid.ColumnSpan="5"
              BorderThickness="0,0,0,1" BorderBrush="{DynamicResource Brush.Border0}"
              Background="{DynamicResource Brush.TitleBar}"
              Win32Properties.NonClientHitTestResult="Caption"
              DoubleTapped="MaximizeOrRestoreWindow"
              PointerPressed="BeginMoveWindow"/>

      <!-- Left: window controls, aligned above the sidebar -->
      <Grid Grid.Column="0"
            IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed, Converter={x:Static BoolConverters.Not}}">
        <v:MacOSTrafficLightsSpacer
            HorizontalAlignment="Left"
            Zoom="{Binding Source={x:Static vm:Preferences.Instance}, Path=Zoom, Mode=OneWay}"
            IsFullScreen="{Binding #ThisControl.WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.FullScreen}}"
            IsVisible="{Binding #ThisControl.ShowMacOSTrafficLights}"/>

        <!-- macOS: welcome button at the right edge of the sidebar title bar -->
        <Button Classes="icon_button"
                Width="30" Height="30"
                Margin="0,0,4,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                IsVisible="{Binding #ThisControl.ShowMacOSTrafficLights}"
                Click="OnShowWelcome">
          <Path Width="14" Height="14" Data="{StaticResource Icons.Home}" Fill="{DynamicResource Brush.FG1}"/>
          <ToolTip.Tip>
            <TextBlock>
              <Run Text="{DynamicResource Text.Sidebar.OpenWelcome}"/>
              <Run Text=" "/>
              <Run Text="{OnPlatform Ctrl+T, macOS=⌘+T}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
            </TextBlock>
          </ToolTip.Tip>
        </Button>

        <!-- Other platforms: welcome button on the left, menu on its right -->
        <StackPanel Orientation="Horizontal"
                    IsVisible="{Binding !#ThisControl.ShowMacOSTrafficLights}">
          <Button Classes="icon_button"
                  Width="30" Height="30"
                  Margin="4,0,0,0"
                  VerticalAlignment="Center"
                  Click="OnShowWelcome">
            <Path Width="14" Height="14" Data="{StaticResource Icons.Home}" Fill="{DynamicResource Brush.FG1}"/>
            <ToolTip.Tip>
              <TextBlock>
                <Run Text="{DynamicResource Text.Sidebar.OpenWelcome}"/>
                <Run Text=" "/>
                <Run Text="{OnPlatform Ctrl+T, macOS=⌘+T}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
              </TextBlock>
            </ToolTip.Tip>
          </Button>
          <v:LauncherMenuButton/>
        </StackPanel>
      </Grid>

      <!-- Vertical separator between sidebar and content -->
      <Border Grid.Column="1"
              BorderThickness="0,0,1,0"
              BorderBrush="{DynamicResource Brush.Border2}"
              IsHitTestVisible="False"/>

      <!-- Active Page Toolbar -->
      <Grid Grid.Column="2" ColumnDefinitions="Auto,Auto,*">
        <!-- Window controls and welcome button when the sidebar is collapsed -->
        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
          <!-- macOS traffic lights -->
          <Panel IsVisible="{Binding #ThisControl.ShowMacOSTrafficLights}">
            <v:MacOSTrafficLightsSpacer
                IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed}"
                Zoom="{Binding Source={x:Static vm:Preferences.Instance}, Path=Zoom, Mode=OneWay}"
                IsFullScreen="{Binding #ThisControl.WindowState, Converter={x:Static ObjectConverters.Equal}, ConverterParameter={x:Static WindowState.FullScreen}}"/>
          </Panel>

          <Panel IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed}">
            <Button Classes="icon_button"
                    Width="30" Height="30"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Click="OnShowWelcome">
              <Path Width="14" Height="14" Data="{StaticResource Icons.Home}" Fill="{DynamicResource Brush.FG1}"/>
              <ToolTip.Tip>
                <TextBlock>
                  <Run Text="{DynamicResource Text.Sidebar.OpenWelcome}"/>
                  <Run Text=" "/>
                  <Run Text="{OnPlatform Ctrl+T, macOS=⌘+T}" FontSize="11" Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
                </TextBlock>
              </ToolTip.Tip>
            </Button>
          </Panel>

          <!-- Windows/Linux menu -->
          <Panel IsVisible="{OnPlatform True, macOS=False}">
            <v:LauncherMenuButton IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed}"/>
          </Panel>
        </StackPanel>

        <!-- Collapse/expand the workspace sidebar -->
        <Button Grid.Column="1"
                Classes="icon_button"
                Width="32" Height="32"
                VerticalAlignment="Center"
                Click="OnToggleWorkspaceSidebar">
          <Panel>
            <Path Width="14" Height="14"
                  Data="{StaticResource Icons.Sidebar.Expanded}"
                  IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed, Converter={x:Static BoolConverters.Not}}"/>
            <Path Width="14" Height="14"
                  Data="{StaticResource Icons.Sidebar.Collapsed}"
                  IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed}"/>
          </Panel>
          <ToolTip.Tip>
            <Panel>
              <TextBlock Text="{DynamicResource Text.WorkspaceSidebar.Collapse}"
                         IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed, Converter={x:Static BoolConverters.Not}}"/>
              <TextBlock Text="{DynamicResource Text.WorkspaceSidebar.Expand}"
                         IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed}"/>
            </Panel>
          </ToolTip.Tip>
        </Button>

        <!-- Page toolbar -->
        <ContentControl Grid.Column="2"
                        Margin="4,0,0,0"
                        VerticalAlignment="Stretch"
                        Content="{Binding ActivePage.Data}">
          <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:Welcome">
              <v:WelcomeToolbar/>
            </DataTemplate>

            <DataTemplate DataType="vm:Repository">
              <v:RepositoryToolbar/>
            </DataTemplate>
          </ContentControl.DataTemplates>
        </ContentControl>
      </Grid>

      <!-- Update Available Button -->
      <Button Grid.Column="3"
              Classes="icon_button"
              Height="30"
              Margin="0,0,4,0"
              VerticalAlignment="Top"
              IsVisible="{Binding NewVersion, Converter={x:Static ObjectConverters.IsNotNull}}"
              Click="OnShowNewVersion"
              ToolTip.Tip="{DynamicResource Text.Launcher.NewVersion}">
        <Path Width="15" Height="15" Margin="0,4,0,0" Data="{StaticResource Icons.SoftwareUpdate}" Fill="{DynamicResource Brush.Accent}"/>
      </Button>

      <!-- Caption Buttons (Windows/Linux) -->
      <Border Grid.Column="4" IsVisible="{Binding #ThisControl.HasRightCaptionButton}">
        <v:CaptionButtons Height="30" VerticalAlignment="Top"/>
      </Border>
    </Grid>

    <!-- Page -->
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.VisibleWorkspaceSidebarWidth, Mode=TwoWay}"
                          MinWidth="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarMinWidth}"
                          MaxWidth="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarMaxWidth}"/>
        <ColumnDefinition Width="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarSplitterWidth, Mode=OneWay}"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <!-- Workspace Sidebar -->
      <Border Grid.Column="0"
              Background="{DynamicResource Brush.Window}"
              IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed, Converter={x:Static BoolConverters.Not}}">
        <v:WorkspaceSidebar/>
      </Border>

      <!-- Splitter -->
      <GridSplitter Grid.Column="1"
                    MinWidth="1"
                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                    Background="Transparent"
                    BorderThickness="0,0,1,0"
                    BorderBrush="{DynamicResource Brush.Border2}"
                    IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=Layout.WorkspaceSidebarCollapsed, Converter={x:Static BoolConverters.Not}}"
                    PointerReleased="OnWorkspaceSidebarSplitterReleased"
                    PointerCaptureLost="OnWorkspaceSidebarSplitterCaptureLost"
                    Focusable="False"/>

      <!-- Active Page -->
      <ContentControl Grid.Column="2" Content="{Binding ActivePage}" Background="{DynamicResource Brush.Window}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:LauncherPage">
            <v:LauncherPage/>
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </Grid>

    <!-- Command Palette -->
    <Border Grid.Row="0" Grid.RowSpan="2"
            Background="Transparent"
            IsVisible="{Binding CommandPalette, Converter={x:Static ObjectConverters.IsNotNull}}"
            PointerPressed="OnCloseCommandPalette">
      <Border Width="420" HorizontalAlignment="Center" VerticalAlignment="Center" Effect="drop-shadow(0 0 12 #60000000)">
        <Border Background="{DynamicResource Brush.Popup}"
                BorderThickness="1" BorderBrush="{DynamicResource Brush.PopupBorder}"
                CornerRadius="8">
          <ContentControl Margin="16,10,16,12" Content="{Binding CommandPalette}">
            <ContentControl.DataTemplates>
              <v:CommandPaletteDataTemplates/>
            </ContentControl.DataTemplates>
          </ContentControl>
        </Border>
      </Border>
    </Border>

    <!-- Folder import overlay -->
    <Panel Grid.Row="0" Grid.RowSpan="2"
           IsVisible="{Binding ImportDrop.IsActive}">
      <Border Background="#9E000000" IsHitTestVisible="False"/>

      <Grid Width="600"
            MaxHeight="560"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            IsHitTestVisible="{Binding ImportDrop.IsPinned}">
        <Border Background="{DynamicResource Brush.Popup}"
                BorderThickness="1"
                BorderBrush="{DynamicResource Brush.PopupBorder}"
                CornerRadius="14"
                BoxShadow="0 10 36 0 #90000000"/>

        <Grid Margin="26,22,26,18" RowDefinitions="Auto,*,Auto,Auto">
          <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
            <Panel Grid.Column="0"
                   Width="46" Height="46"
                   Margin="0,0,14,0"
                   VerticalAlignment="Center">
              <Border CornerRadius="12"
                      Background="{DynamicResource Brush.Accent}"
                      Opacity=".16"/>
              <Path Width="22" Height="22"
                    Data="{StaticResource Icons.Folder.Open}"
                    Fill="{DynamicResource Brush.Accent}"/>
            </Panel>

            <StackPanel Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
              <TextBlock FontSize="18"
                         FontWeight="Bold"
                         Text="{DynamicResource Text.Import.Title}"/>
              <TextBlock FontSize="12"
                         Foreground="{DynamicResource Brush.FG2}"
                         IsVisible="{Binding !ImportDrop.IsPinned}"
                         Text="{DynamicResource Text.Import.Hint}"/>
              <TextBlock Margin="0,2,0,0"
                         FontSize="11"
                         Foreground="{DynamicResource Brush.FG2}"
                         IsVisible="{Binding ImportDrop.HasItems}"
                         Text="{Binding ImportDrop.Summary}"/>
            </StackPanel>

            <Button Grid.Column="2"
                    Classes="icon_button"
                    Width="28" Height="28"
                    Margin="12,0,0,0"
                    VerticalAlignment="Top"
                    IsVisible="{Binding ImportDrop.IsPinned}"
                    Click="OnCloseImportOverlay"
                    ToolTip.Tip="{DynamicResource Text.Import.Close}">
              <Path Width="12" Height="12" Data="{StaticResource Icons.Close}"/>
            </Button>
          </Grid>

          <Border Grid.Row="1"
                  Margin="0,16,0,0"
                  IsVisible="{Binding ImportDrop.HasItems}"
                  Background="{DynamicResource Brush.Contents}"
                  CornerRadius="8">
            <ScrollViewer MaxHeight="260"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
              <ItemsControl ItemsSource="{Binding ImportDrop.Items}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate DataType="vm:ImportDropItem">
                    <Grid Height="46"
                          Margin="12,0"
                          ColumnDefinitions="Auto,Auto,*,Auto">
                      <CheckBox Grid.Column="0"
                                Width="18" Height="18"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                IsVisible="{Binding IsPinned}"
                                IsChecked="{Binding IsSelected}"
                                IsEnabled="{Binding CanSelect}"/>

                      <Path Grid.Column="1"
                            Width="14" Height="14"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Data="{StaticResource Icons.Folder}"
                            Fill="{DynamicResource Brush.FG2}"/>

                      <StackPanel Grid.Column="2"
                                  VerticalAlignment="Center"
                                  Spacing="1"
                                  ClipToBounds="True">
                        <TextBlock Text="{Binding Name}"
                                   TextTrimming="CharacterEllipsis"/>
                        <TextBlock FontSize="10"
                                   Foreground="{DynamicResource Brush.FG2}"
                                   Text="{Binding DisplayPath}"
                                   TextTrimming="CharacterEllipsis"/>
                      </StackPanel>

                      <TextBlock Grid.Column="3"
                                 Margin="16,0,0,0"
                                 VerticalAlignment="Center"
                                 FontSize="11"
                                 Classes.ready="{Binding IsReady}"
                                 Text="{Binding StatusText}">
                        <TextBlock.Styles>
                          <Style Selector="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                          </Style>
                          <Style Selector="TextBlock.ready">
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                          </Style>
                        </TextBlock.Styles>
                      </TextBlock>
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </ScrollViewer>
          </Border>

          <Grid Grid.Row="2"
                x:Name="ImportPinArea"
                Width="340" Height="40"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                IsVisible="{Binding !ImportDrop.IsPinned}">
            <Border CornerRadius="8"
                    Background="{DynamicResource Brush.Accent}"
                    Opacity=".10"/>
            <Border CornerRadius="8"
                    BorderThickness="1"
                    BorderBrush="{DynamicResource Brush.Accent}"
                    Opacity=".55"/>
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.Accent}"
                       Text="{DynamicResource Text.Import.PinHint}"/>
          </Grid>

          <Grid Grid.Row="3" Margin="2,14,0,0" ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0"
                       VerticalAlignment="Center"
                       FontSize="11"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{DynamicResource Text.Import.EscHint}"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        IsVisible="{Binding ImportDrop.IsPinned}">
              <Button Classes="flat"
                      Height="28"
                      Padding="12,0"
                      Content="{DynamicResource Text.Import.SelectAll}"
                      Click="OnSelectAllImport"/>
              <Button Classes="flat primary"
                      Height="28"
                      Padding="12,0"
                      Margin="8,0,0,0"
                      Content="{DynamicResource Text.Import.ImportSelected}"
                      IsEnabled="{Binding ImportDrop.CanImport}"
                      Click="OnImportSelected"/>
            </StackPanel>
          </Grid>
        </Grid>
      </Grid>
    </Panel>
  </Grid>
</v:ChromelessWindow>
