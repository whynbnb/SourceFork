<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceFork.Models"
             xmlns:vm="using:SourceFork.ViewModels"
             xmlns:v="using:SourceFork.Views"
             xmlns:c="using:SourceFork.Converters"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="600"
             x:Class="SourceFork.Views.WorkspaceSidebar"
             x:DataType="vm:Launcher">
  <UserControl.Styles>
    <Style Selector="Border.search_box">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
    </Style>
    <Style Selector="Border.search_box:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.sidebar_action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.sidebar_action:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Repository Search and Tag Filter -->
    <Grid Grid.Row="0" Height="34" Margin="8,10,8,6" ColumnDefinitions="*,Auto,Auto">
      <Border Grid.Column="0"
              Classes="search_box"
              Height="30"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Contents}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0"
                Width="12" Height="12"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Data="{StaticResource Icons.Search}"
                Fill="{DynamicResource Brush.FG2}"/>
          <TextBox Grid.Column="1"
                   Margin="4,0,6,0"
                   Padding="0"
                   VerticalAlignment="Center"
                   Classes="no_border no_background"
                   PlaceholderText="{DynamicResource Text.Welcome.Search}"
                   Text="{Binding RepositoryFilter, Mode=TwoWay}"/>
        </Grid>
      </Border>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="30" Height="30"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              Click="OnTagFilterMenu">
        <ToolTip.Tip>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Text.Sidebar.FilterByTags}" FontWeight="Bold"/>
            <TextBlock Margin="6,0,0,0"
                       Text="{Binding TagFilterCount, Mode=OneWay}"
                       IsVisible="{Binding HasTagFilters, Mode=OneWay}"
                       Foreground="{DynamicResource Brush.Accent}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Panel>
          <Path Width="14" Height="14" Data="{StaticResource Icons.Tags}" Fill="{DynamicResource Brush.FG1}"/>
          <Ellipse Width="7" Height="7"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Fill="{DynamicResource Brush.Accent}"
                   IsVisible="{Binding HasTagFilters, Mode=OneWay}"/>
        </Panel>
      </Button>

      <Button Grid.Column="2"
              Classes="icon_button"
              Width="30" Height="30"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              Click="OnSortMenu">
        <ToolTip.Tip>
          <TextBlock Text="{DynamicResource Text.RepositorySort.Title}" FontWeight="Bold"/>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Data="{StaticResource Icons.OrderByName}" Fill="{DynamicResource Brush.FG1}"/>
      </Button>
    </Grid>

    <!-- Repositories -->
    <ListBox x:Name="PagesList"
             Grid.Row="1"
             Margin="6,0"
             Background="Transparent"
             ItemsSource="{Binding VisiblePages}"
             SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
             SelectionMode="Single"
             DragDrop.AllowDrop="True"
             DragDrop.DragOver="OnPagesDragOver"
             DragDrop.Drop="OnPagesDrop"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Margin" Value="0,1"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Template">
            <ControlTemplate>
              <Grid>
                <Border Name="PART_Background"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"/>
                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Stretch"/>
              </Grid>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="Opacity" Value=".08"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="Opacity" Value=".2"/>
        </Style>
        <Style Selector="ListBoxItem Button.page_close">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.page_close, ListBoxItem:selected Button.page_close">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
      </ListBox.Styles>

      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:RepositoryListRow">
          <Grid Background="Transparent">
            <TextBlock Height="26"
                       Margin="10,6,8,2"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding GroupName}"
                       TextTrimming="CharacterEllipsis"
                       IsVisible="{Binding IsGroupHeader}"/>

            <Grid Height="42"
                  ColumnDefinitions="Auto,*,Auto,Auto"
                  ContextRequested="OnItemContextRequested"
                  PointerPressed="OnRowPointerPressed"
                  PointerMoved="OnRowPointerMoved"
                  PointerReleased="OnRowPointerReleased"
                  IsVisible="{Binding !IsGroupHeader}">
              <ToolTip.Tip>
                <Grid>
                  <TextBlock Text="{DynamicResource Text.Welcome}" IsVisible="{Binding !Page.Node.IsRepository}"/>
                  <StackPanel IsVisible="{Binding Page.Node.IsRepository}">
                    <TextBlock Text="{Binding Page.Node.Id}"/>
                    <TextBlock Text="{Binding Page.DirtyState, Converter={x:Static c:DirtyStateConverters.ToDesc}}"
                               Foreground="{DynamicResource Brush.FG2}"/>
                  </StackPanel>
                </Grid>
              </ToolTip.Tip>

              <v:Bookmark Grid.Column="0"
                          Width="12" Height="12"
                          Margin="10,0,8,0"
                          VerticalAlignment="Center"
                          Value="{Binding Page.Node.Bookmark, Mode=OneWay}"
                          IsVisible="{Binding Page.Node.IsRepository}"/>
              <Path Grid.Column="0"
                    Width="12" Height="12"
                    Margin="10,0,8,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource Brush.FG1}"
                    Data="{StaticResource Icons.Repositories}"
                    IsVisible="{Binding !Page.Node.IsRepository}"
                    IsHitTestVisible="False"/>

              <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
                <TextBlock Grid.Row="0"
                           FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize, Converter={x:Static c:DoubleConverters.Decrease}}"
                           Text="{Binding Page.Node.Name}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Page.Node.IsRepository}"/>
                <TextBlock Grid.Row="0"
                           FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize, Converter={x:Static c:DoubleConverters.Decrease}}"
                           Text="{DynamicResource Text.PageTabBar.Welcome.Title}"
                           IsVisible="{Binding !Page.Node.IsRepository}"/>
                <Grid Grid.Row="1" ColumnDefinitions="*,Auto" IsVisible="{Binding Page.Node.IsRepository}">
                  <TextBlock Grid.Column="0"
                             FontSize="10"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding Page.Node.Id}"
                             TextTrimming="CharacterEllipsis"/>
                  <ItemsControl Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Page.Node.TagItems}"
                                IsVisible="{Binding Page.Node.HasTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RepositoryTagItem">
                        <TextBlock Margin="4,0,0,0"
                                   FontSize="10"
                                   Text="{Binding DisplayName}"
                                   Classes.primary="{Binding IsPrimary}">
                          <TextBlock.Styles>
                            <Style Selector="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                            </Style>
                            <Style Selector="TextBlock.primary">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                              <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                          </TextBlock.Styles>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Grid>
              </Grid>

              <Ellipse Grid.Column="2"
                       Width="8" Height="8"
                       Margin="6,0"
                       VerticalAlignment="Center"
                       IsVisible="{Binding Page.DirtyState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:DirtyState.None}}"
                       Fill="{Binding Page.DirtyState, Converter={x:Static c:DirtyStateConverters.ToBrush}}"/>

              <Button Grid.Column="3"
                      Classes="icon_button page_close"
                      Width="20" Height="20"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      Click="OnClosePage"
                      IsVisible="{Binding Page.Node.IsRepository}"
                      ToolTip.Tip="{DynamicResource Text.PageTabBar.Tab.Close}">
                <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
              </Button>
            </Grid>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- New Page -->
    <Border Grid.Row="2"
            Padding="8,4,8,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Brush.Border0}">
      <Button Classes="flat sidebar_action"
              Height="30"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Click="OnAddPage">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="10" Height="10" Data="{StaticResource Icons.Plus}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Margin="8,0,0,0" Text="{DynamicResource Text.PageTabBar.New}" VerticalAlignment="Center"/>
          <TextBlock Margin="16,0,0,0"
                     Text="{OnPlatform Ctrl+T, macOS=⌘+T}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
        </StackPanel>
      </Button>
    </Border>
  </Grid>
</UserControl>
