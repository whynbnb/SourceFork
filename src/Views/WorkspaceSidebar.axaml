<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceGit.Models"
             xmlns:vm="using:SourceGit.ViewModels"
             xmlns:v="using:SourceGit.Views"
             xmlns:c="using:SourceGit.Converters"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="600"
             x:Class="SourceGit.Views.WorkspaceSidebar"
             x:DataType="vm:Launcher">
  <UserControl.Styles>
    <Style Selector="Border.search_box">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
    </Style>
    <Style Selector="Border.search_box:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.sidebar_action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.sidebar_action:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Repository Search and Workspace Switcher -->
    <Grid Grid.Row="0" Height="34" Margin="8,10,8,6" ColumnDefinitions="*,Auto">
      <Border Grid.Column="0"
              Classes="search_box"
              Height="30"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Contents}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0"
                Width="12" Height="12"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Data="{StaticResource Icons.Search}"
                Fill="{DynamicResource Brush.FG2}"/>
          <TextBox Grid.Column="1"
                   Margin="4,0,6,0"
                   Padding="0"
                   VerticalAlignment="Center"
                   Classes="no_border no_background"
                   Watermark="{DynamicResource Text.Welcome.Search}"
                   Text="{Binding RepositoryFilter, Mode=TwoWay}"/>
        </Grid>
      </Border>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="30" Height="30"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              Click="OnWorkspaceMenu"
              HotKey="{OnPlatform Ctrl+Alt+P, macOS=⌘+Alt+P}">
        <ToolTip.Tip>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Text.Workspace}" FontWeight="Bold"/>
            <TextBlock Text="{Binding ActiveWorkspace.Name}"/>
            <TextBlock Margin="16,0,0,0"
                       Text="{OnPlatform Ctrl+Alt+P, macOS=⌘+Alt+P}"
                       FontSize="11"
                       Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Path Width="14" Height="14" Data="{StaticResource Icons.Workspace}" Fill="{Binding ActiveWorkspace.Brush}"/>
      </Button>
    </Grid>

    <!-- Repositories -->
    <ListBox x:Name="PagesList"
             Grid.Row="1"
             Margin="6,0"
             Background="Transparent"
             ItemsSource="{Binding VisiblePages}"
             SelectedItem="{Binding ActivePage, Mode=TwoWay}"
             SelectionMode="Single"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Height" Value="42"/>
          <Setter Property="Margin" Value="0,1"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Template">
            <ControlTemplate>
              <Grid>
                <Border Name="PART_Background"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"/>
                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Stretch"/>
              </Grid>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="Opacity" Value=".08"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="Opacity" Value=".2"/>
        </Style>
        <Style Selector="ListBoxItem Button.page_close">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.page_close, ListBoxItem:selected Button.page_close">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
      </ListBox.Styles>

      <ListBox.ItemTemplate>
        <DataTemplate DataType="vm:LauncherPage">
          <Grid Height="42"
                Background="Transparent"
                ColumnDefinitions="Auto,*,Auto,Auto"
                ContextRequested="OnItemContextRequested">
            <ToolTip.Tip>
              <Grid>
                <TextBlock Text="{DynamicResource Text.Welcome}" IsVisible="{Binding !Node.IsRepository}"/>
                <StackPanel IsVisible="{Binding Node.IsRepository}">
                  <TextBlock Text="{Binding Node.Id}"/>
                  <TextBlock Text="{Binding DirtyState, Converter={x:Static c:DirtyStateConverters.ToDesc}}"
                             Foreground="{DynamicResource Brush.FG2}"/>
                </StackPanel>
              </Grid>
            </ToolTip.Tip>

            <v:Bookmark Grid.Column="0"
                        Width="12" Height="12"
                        Margin="10,0,8,0"
                        VerticalAlignment="Center"
                        Value="{Binding Node.Bookmark, Mode=OneWay}"
                        IsVisible="{Binding Node.IsRepository}"/>
            <Path Grid.Column="0"
                  Width="12" Height="12"
                  Margin="10,0,8,0"
                  VerticalAlignment="Center"
                  Fill="{DynamicResource Brush.FG1}"
                  Data="{StaticResource Icons.Repositories}"
                  IsVisible="{Binding !Node.IsRepository}"
                  IsHitTestVisible="False"/>

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Row="0"
                         FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize, Converter={x:Static c:DoubleConverters.Decrease}}"
                         Text="{Binding Node.Name}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Node.IsRepository}"/>
              <TextBlock Grid.Row="0"
                         FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize, Converter={x:Static c:DoubleConverters.Decrease}}"
                         Text="{DynamicResource Text.PageTabBar.Welcome.Title}"
                         IsVisible="{Binding !Node.IsRepository}"/>
              <TextBlock Grid.Row="1"
                         FontSize="10"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding Node.Id}"
                         TextTrimming="CharacterEllipsis"
                         IsVisible="{Binding Node.IsRepository}"/>
            </Grid>

            <Ellipse Grid.Column="2"
                     Width="8" Height="8"
                     Margin="6,0"
                     VerticalAlignment="Center"
                     IsVisible="{Binding DirtyState, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter={x:Static m:DirtyState.None}}"
                     Fill="{Binding DirtyState, Converter={x:Static c:DirtyStateConverters.ToBrush}}"/>

            <Button Grid.Column="3"
                    Classes="icon_button page_close"
                    Width="20" Height="20"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Click="OnClosePage"
                    IsVisible="{Binding Node.IsRepository}"
                    ToolTip.Tip="{DynamicResource Text.PageTabBar.Tab.Close}">
              <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
            </Button>
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>

    <!-- New Page -->
    <Border Grid.Row="2"
            Padding="8,4,8,8"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Brush.Border0}">
      <Button Classes="flat sidebar_action"
              Height="30"
              HorizontalAlignment="Stretch"
              HorizontalContentAlignment="Left"
              Click="OnAddPage">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Path Width="10" Height="10" Data="{StaticResource Icons.Plus}" Fill="{DynamicResource Brush.FG1}"/>
          <TextBlock Margin="8,0,0,0" Text="{DynamicResource Text.PageTabBar.New}" VerticalAlignment="Center"/>
          <TextBlock Margin="16,0,0,0"
                     Text="{OnPlatform Ctrl+T, macOS=⌘+T}"
                     FontSize="11"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource MenuFlyoutItemKeyboardAcceleratorTextForeground}"/>
        </StackPanel>
      </Button>
    </Border>
  </Grid>
</UserControl>
