<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:m="using:SourceFork.Models"
             xmlns:vm="using:SourceFork.ViewModels"
             xmlns:v="using:SourceFork.Views"
             xmlns:c="using:SourceFork.Converters"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="600"
             x:Class="SourceFork.Views.WorkspaceSidebar"
             x:DataType="vm:Launcher">
  <UserControl.Styles>
    <Style Selector="Border.search_box">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border2}"/>
    </Style>
    <Style Selector="Border.search_box:focus-within">
      <Setter Property="BorderBrush" Value="{DynamicResource Brush.Accent}"/>
    </Style>
    <Style Selector="Button.sidebar_action">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="Button.sidebar_action:pointerover /template/ Border#PART_Border">
      <Setter Property="Background" Value="{DynamicResource Brush.AccentHovered}"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*">
    <!-- Repository Search and Tag Filter -->
    <Grid Grid.Row="0" Height="34" Margin="8,10,8,6" ColumnDefinitions="*,Auto">
      <Border Grid.Column="0"
              Classes="search_box"
              Height="30"
              VerticalAlignment="Center"
              Background="{DynamicResource Brush.Contents}"
              BorderThickness="1"
              CornerRadius="6">
        <Grid ColumnDefinitions="Auto,*">
          <Path Grid.Column="0"
                Width="12" Height="12"
                Margin="8,0,0,0"
                VerticalAlignment="Center"
                Data="{StaticResource Icons.Search}"
                Fill="{DynamicResource Brush.FG2}"/>
          <TextBox Grid.Column="1"
                   Margin="4,0,6,0"
                   Padding="0"
                   VerticalAlignment="Center"
                   Classes="no_border no_background"
                   PlaceholderText="{DynamicResource Text.Welcome.Search}"
                   Text="{Binding RepositoryFilter, Mode=TwoWay}"/>
        </Grid>
      </Border>

      <Button Grid.Column="1"
              Classes="icon_button"
              Width="30" Height="30"
              Margin="4,0,0,0"
              VerticalAlignment="Center"
              Click="OnTagFilterMenu">
        <ToolTip.Tip>
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="{DynamicResource Text.Sidebar.FilterByTags}" FontWeight="Bold"/>
            <TextBlock Margin="6,0,0,0"
                       Text="{Binding TagFilterCount, Mode=OneWay}"
                       IsVisible="{Binding HasTagFilters, Mode=OneWay}"
                       Foreground="{DynamicResource Brush.Accent}"/>
          </StackPanel>
        </ToolTip.Tip>
        <Panel>
          <Path Width="14" Height="14" Data="{StaticResource Icons.Tags}" Fill="{DynamicResource Brush.FG1}"/>
          <Ellipse Width="7" Height="7"
                   HorizontalAlignment="Right" VerticalAlignment="Top"
                   Fill="{DynamicResource Brush.Accent}"
                   IsVisible="{Binding HasTagFilters, Mode=OneWay}"/>
        </Panel>
      </Button>
    </Grid>

    <!-- Repositories -->
    <Grid Grid.Row="1" Margin="6,0" ClipToBounds="True">
      <ListBox x:Name="PagesList"
               Background="Transparent"
               ItemsSource="{Binding VisiblePages}"
               SelectedItem="{Binding SelectedRow, Mode=TwoWay}"
               SelectionMode="Single"
               AutoScrollToSelectedItem="False"
               ContextRequested="OnPagesContextRequested"
               DragDrop.AllowDrop="True"
               DragDrop.DragOver="OnPagesDragOver"
               DragDrop.DragLeave="OnPagesDragLeave"
               DragDrop.Drop="OnPagesDrop"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.Styles>
        <Style Selector="ListBoxItem">
          <Setter Property="Margin" Value="0,1"/>
          <Setter Property="Padding" Value="0"/>
          <Setter Property="CornerRadius" Value="6"/>
          <Setter Property="Template">
            <ControlTemplate>
              <Grid>
                <Border Name="PART_Background"
                        Background="Transparent"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Opacity="0"/>
                <ContentPresenter ContentTemplate="{TemplateBinding ContentTemplate}"
                                  Content="{TemplateBinding Content}"
                                  Padding="{TemplateBinding Padding}"
                                  VerticalContentAlignment="Center"
                                  HorizontalContentAlignment="Stretch"/>
              </Grid>
            </ControlTemplate>
          </Setter>
        </Style>
        <Style Selector="ListBoxItem:pointerover /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource Brush.FG1}"/>
          <Setter Property="Opacity" Value=".03"/>
        </Style>
        <Style Selector="ListBoxItem:selected /template/ Border#PART_Background">
          <Setter Property="Background" Value="{DynamicResource Brush.Accent}"/>
          <Setter Property="Opacity" Value=".18"/>
        </Style>
        <Style Selector="ListBoxItem Button.page_close">
          <Setter Property="Opacity" Value="0"/>
          <Setter Property="IsHitTestVisible" Value="False"/>
        </Style>
        <Style Selector="ListBoxItem:pointerover Button.page_close, ListBoxItem:selected Button.page_close">
          <Setter Property="Opacity" Value="1"/>
          <Setter Property="IsHitTestVisible" Value="True"/>
        </Style>
      </ListBox.Styles>

      <ListBox.DataTemplates>
        <DataTemplate DataType="vm:RepositoryGroupRow">
          <Grid Height="26"
                Margin="10,6,8,2"
                ColumnDefinitions="Auto,*"
                Background="Transparent">
            <Path Grid.Column="0"
                  Width="10" Height="10"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center"
                  Data="{StaticResource Icons.Down}"
                  Fill="{DynamicResource Brush.FG2}"
                  IsVisible="{Binding IsExpanded}"/>
            <Path Grid.Column="0"
                  Width="10" Height="10"
                  Margin="0,0,4,0"
                  VerticalAlignment="Center"
                  Data="{StaticResource Icons.Down}"
                  Fill="{DynamicResource Brush.FG2}"
                  IsVisible="{Binding IsCollapsed}"
                  RenderTransformOrigin="50%,50%"
                  RenderTransform="rotate(270deg)"/>
            <TextBlock Grid.Column="1"
                       VerticalAlignment="Center"
                       FontSize="11"
                       FontWeight="Bold"
                       Foreground="{DynamicResource Brush.FG2}"
                       Text="{Binding GroupName}"
                       TextTrimming="CharacterEllipsis"/>
            <ToolTip.Tip>
              <Panel>
                <TextBlock Text="{DynamicResource Text.RepositorySort.CollapseGroup}" IsVisible="{Binding IsExpanded}"/>
                <TextBlock Text="{DynamicResource Text.RepositorySort.ExpandGroup}" IsVisible="{Binding IsCollapsed}"/>
              </Panel>
            </ToolTip.Tip>
          </Grid>
        </DataTemplate>

        <DataTemplate DataType="vm:RepositoryListRow">
          <Grid Background="Transparent">
            <Grid MinHeight="42"
                  ColumnDefinitions="*,Auto"
                  PointerPressed="OnRowPointerPressed"
                  PointerMoved="OnRowPointerMoved"
                  PointerReleased="OnRowPointerReleased"
                  PointerCaptureLost="OnRowPointerCaptureLost">
              <ToolTip.Tip>
                <StackPanel>
                  <TextBlock Text="{Binding Node.Id}"/>
                  <TextBlock Text="{Binding DirtyState, Converter={x:Static c:DirtyStateConverters.ToDesc}}"
                             IsVisible="{Binding IsDirty}"
                             Foreground="{DynamicResource Brush.FG2}"/>
                </StackPanel>
              </ToolTip.Tip>

              <Grid Grid.Column="0" RowDefinitions="Auto,Auto,Auto" VerticalAlignment="Center" ClipToBounds="True">
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
                  <Panel Grid.Column="0" Width="14" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8"
                             HorizontalAlignment="Left" VerticalAlignment="Center"
                             IsVisible="{Binding IsDirty}"
                             Fill="{Binding DirtyState, Converter={x:Static c:DirtyStateConverters.ToBrush}}"/>
                  </Panel>
                  <TextBlock Grid.Column="1"
                             FontSize="{Binding Source={x:Static vm:Preferences.Instance}, Path=DefaultFontSize, Converter={x:Static c:DoubleConverters.Decrease}}"
                             TextTrimming="CharacterEllipsis">
                    <Run Text="{Binding Node.Name, Mode=OneWay}"/>
                    <Run Text="{Binding Node.SecondaryTagsDisplay, Mode=OneWay}"
                         FontSize="10"
                         Foreground="{DynamicResource Brush.FG2}"/>
                  </TextBlock>
                </Grid>
                <TextBlock Grid.Row="1"
                           Margin="14,0,0,0"
                           FontSize="10"
                           Foreground="{DynamicResource Brush.FG2}"
                           Text="{Binding Node.Id}"
                           TextTrimming="CharacterEllipsis"
                           IsVisible="{Binding Source={x:Static vm:Preferences.Instance}, Path=ShowRepositoryPathInSidebar}"/>
                <StackPanel Grid.Row="2"
                            MinHeight="18"
                            Margin="14,3,0,0"
                            Orientation="Horizontal"
                            ClipToBounds="True">
                  <ContentControl VerticalAlignment="Center"
                                  Content="{Binding Node.Status, Mode=OneWay}">
                    <ContentControl.DataTemplates>
                      <DataTemplate DataType="m:RepositoryStatus">
                        <StackPanel Orientation="Horizontal" ClipToBounds="True">
                          <Border Margin="0,0,4,0"
                                  Height="16"
                                  CornerRadius="8"
                                  Padding="5,0"
                                  Background="{DynamicResource Brush.FG1}"
                                  VerticalAlignment="Center"
                                  IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                            <TextBlock Text="{Binding LocalChanges}"
                                       FontFamily="{DynamicResource Fonts.Monospace}"
                                       FontSize="10"
                                       Foreground="{DynamicResource Brush.Window}"/>
                          </Border>

                          <TextBlock Margin="0,0,4,0"
                                     VerticalAlignment="Center"
                                     Text="{Binding TrackingDescription}"
                                     FontFamily="{DynamicResource Fonts.Monospace}"
                                     FontSize="10"
                                     IsVisible="{Binding IsTrackingStatusVisible}"/>

                          <Border BorderThickness="1"
                                  BorderBrush="{DynamicResource Brush.FG2}"
                                  Height="18"
                                  CornerRadius="4"
                                  Padding="3,0"
                                  VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                              <Path Width="10" Height="10" Data="{StaticResource Icons.Branch}"/>
                              <TextBlock Margin="2,0,0,0"
                                         MaxWidth="90"
                                         Text="{Binding CurrentBranch}"
                                         TextTrimming="CharacterEllipsis"
                                         FontSize="10"/>
                            </StackPanel>
                          </Border>
                        </StackPanel>
                      </DataTemplate>
                    </ContentControl.DataTemplates>
                  </ContentControl>

                  <TextBlock Margin="6,0,0,0"
                             VerticalAlignment="Center"
                             FontSize="10"
                             Foreground="{DynamicResource Brush.FG2}"
                             Text="{Binding UpdatedText}"
                             IsVisible="{Binding HasUpdatedText}"/>
                </StackPanel>
              </Grid>

              <Button Grid.Column="1"
                      Classes="icon_button page_close"
                      Width="20" Height="20"
                      Margin="0,0,6,0"
                      VerticalAlignment="Center"
                      IsVisible="{Binding CanClose}"
                      ToolTip.Tip="{DynamicResource Text.Repository.RemoveFromList}">
                <Path Width="8" Height="8" Data="{StaticResource Icons.Close}"/>
              </Button>
            </Grid>
          </Grid>
        </DataTemplate>
      </ListBox.DataTemplates>
    </ListBox>

      <Canvas x:Name="DropIndicatorLayer" IsHitTestVisible="False">
        <Border x:Name="DropIndicator"
                Height="2"
                Background="{DynamicResource Brush.Accent}"
                CornerRadius="1"
                IsVisible="False"/>
      </Canvas>
    </Grid>

  </Grid>
</UserControl>
