<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:c="using:SourceFork.Converters"
             xmlns:m="using:SourceFork.Models"
             xmlns:vm="using:SourceFork.ViewModels"
             xmlns:v="using:SourceFork.Views"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SourceFork.Views.Welcome"
             x:DataType="vm:Welcome">
  <UserControl.Styles>
    <Style Selector="ListBox#TreeContainer /template/ ScrollViewer /template/ ScrollContentPresenter#PART_ContentPresenter">
      <Setter Property="Grid.RowSpan" Value="1"/>
      <Setter Property="Grid.ColumnSpan" Value="1"/>
      <Setter Property="Margin" Value="0,0,16,0"/>
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="*" Margin="8">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="1*"/>
      <ColumnDefinition Width="2*" MinWidth="600"/>
      <ColumnDefinition Width="1*"/>
    </Grid.ColumnDefinitions>

    <!-- Managed Repositories -->
    <Grid Grid.Row="0" Grid.Column="1" RowDefinitions="Auto,*">
      <!-- Search and Tag Filter -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
        <TextBox Grid.Column="0"
                 x:Name="SearchBox"
                 Height="32"
                 Padding="0"
                 CornerRadius="16"
                 BorderBrush="{DynamicResource Brush.Border0}"
                 BorderThickness="1"
                 Background="{DynamicResource Brush.Contents}"
                 PlaceholderText="{DynamicResource Text.Welcome.Search}"
                 VerticalContentAlignment="Center"
                 Text="{Binding SearchFilter, Mode=TwoWay}">
          <TextBox.Styles>
            <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
            </Style>
            <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
              <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border0}"/>
            </Style>
          </TextBox.Styles>

          <TextBox.InnerLeftContent>
            <Path Width="16" Height="16" Margin="6,0,3,0" Data="{StaticResource Icons.Search}" Fill="{DynamicResource Brush.FG2}"/>
          </TextBox.InnerLeftContent>

          <TextBox.InnerRightContent>
            <StackPanel Orientation="Horizontal">
              <!-- Invisible Button to handle search hotkey pressed-->
              <Button Width="0" Height="0"
                      Margin="0" Padding="0"
                      Click="OnSearchHotKey"
                      HotKey="{OnPlatform Ctrl+F, macOS=⌘+F}"/>

              <Button Classes="icon_button" IsVisible="{Binding SearchFilter, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Click="OnClearSearchFilter">
                <Path Width="16" Height="16" Margin="0,0,0,0" Data="{StaticResource Icons.Clear}" Fill="{DynamicResource Brush.FG1}"/>
              </Button>
            </StackPanel>
          </TextBox.InnerRightContent>
        </TextBox>

        <Button Grid.Column="1"
                Classes="icon_button"
                Width="32" Height="32"
                Margin="8,0,0,0"
                Click="OnTagFilterMenu">
          <ToolTip.Tip>
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="{DynamicResource Text.Sidebar.FilterByTags}"/>
              <TextBlock Margin="6,0,0,0"
                         Text="{Binding TagFilterCount, Mode=OneWay}"
                         IsVisible="{Binding HasTagFilters, Mode=OneWay}"
                         Foreground="{DynamicResource Brush.Accent}"/>
            </StackPanel>
          </ToolTip.Tip>
          <Panel>
            <Path Width="16" Height="16" Data="{StaticResource Icons.Tags}" Fill="{DynamicResource Brush.FG1}"/>
            <Ellipse Width="7" Height="7"
                     HorizontalAlignment="Right" VerticalAlignment="Top"
                     Fill="{DynamicResource Brush.Accent}"
                     IsVisible="{Binding HasTagFilters, Mode=OneWay}"/>
          </Panel>
        </Button>
      </Grid>

      <!-- Repository List -->
      <ListBox Grid.Row="1"
               x:Name="TreeContainer"
               Margin="0,8,8,0"
               Focusable="True"
               Background="Transparent"
               ScrollViewer.HorizontalScrollBarVisibility="Disabled"
               ScrollViewer.VerticalScrollBarVisibility="Auto"
               ItemsSource="{Binding Rows}"
               SelectionMode="Single"
               AutoScrollToSelectedItem="False"
               ContextRequested="OnTreeContextRequested"
               LostFocus="OnTreeViewLostFocus"
               DragDrop.AllowDrop="True"
               DragDrop.DragOver="DragOverTreeView"
               DragDrop.Drop="DropOnTreeView">
        <ListBox.Styles>
          <Style Selector="ListBox">
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>

          <Style Selector="ListBoxItem" x:DataType="vm:RepositoryListRow">
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Padding" Value="0"/>
                <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FocusAdorner">
              <FocusAdornerTemplate>
                <Border Background="Transparent" BorderThickness="0"/>
              </FocusAdornerTemplate>
            </Setter>
          </Style>
        </ListBox.Styles>

        <ListBox.ItemsPanel>
          <ItemsPanelTemplate>
            <VirtualizingStackPanel Orientation="Vertical"/>
          </ItemsPanelTemplate>
        </ListBox.ItemsPanel>

        <ListBox.DataTemplates>
          <DataTemplate DataType="vm:RepositoryGroupRow">
            <Grid Height="26"
                  Margin="4,8,8,2"
                  ColumnDefinitions="Auto,*"
                  Background="Transparent">
              <Path Grid.Column="0"
                    Width="10" Height="10"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Data="{StaticResource Icons.Down}"
                    Fill="{DynamicResource Brush.FG2}"
                    IsVisible="{Binding IsExpanded}"/>
              <Path Grid.Column="0"
                    Width="10" Height="10"
                    Margin="0,0,4,0"
                    VerticalAlignment="Center"
                    Data="{StaticResource Icons.Down}"
                    Fill="{DynamicResource Brush.FG2}"
                    IsVisible="{Binding IsCollapsed}"
                    RenderTransformOrigin="50%,50%"
                    RenderTransform="rotate(270deg)"/>
              <TextBlock Grid.Column="1"
                         VerticalAlignment="Center"
                         FontSize="11"
                         FontWeight="Bold"
                         Foreground="{DynamicResource Brush.FG2}"
                         Text="{Binding GroupName}"
                         TextTrimming="CharacterEllipsis"/>
              <ToolTip.Tip>
                <Panel>
                  <TextBlock Text="{DynamicResource Text.RepositorySort.CollapseGroup}" IsVisible="{Binding IsExpanded}"/>
                  <TextBlock Text="{DynamicResource Text.RepositorySort.ExpandGroup}" IsVisible="{Binding IsCollapsed}"/>
                </Panel>
              </ToolTip.Tip>
            </Grid>
          </DataTemplate>

          <DataTemplate DataType="vm:RepositoryListRow">
            <Grid Background="Transparent">
              <Grid Height="30"
                    ColumnDefinitions="*,Auto"
                    ClipToBounds="True"
                    DoubleTapped="OnDoubleTappedTreeNode"
                    PointerPressed="OnRowPointerPressed"
                    PointerMoved="OnRowPointerMoved"
                    PointerReleased="OnRowPointerReleased"
                    PointerCaptureLost="OnRowPointerCaptureLost">
                <StackPanel Grid.Column="0" Orientation="Horizontal" ClipToBounds="True">
                  <TextBlock VerticalAlignment="Center" Text="{Binding Node.Name}"/>
                  <TextBlock Margin="4,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource Brush.FG2}" Text="{Binding Node.Id, StringFormat=({0}), Converter={x:Static c:PathConverters.RelativeToHome}}">
                    <TextBlock.IsVisible>
                      <MultiBinding Converter="{x:Static BoolConverters.And}">
                        <Binding Path="Node.IsRepository"/>
                        <Binding Path="Node.IsInvalid" Converter="{x:Static BoolConverters.Not}"/>
                      </MultiBinding>
                    </TextBlock.IsVisible>
                  </TextBlock>
                  <ItemsControl Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                ItemsSource="{Binding Node.TagItems}"
                                IsVisible="{Binding Node.HasSecondaryTags}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal"/>
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate DataType="vm:RepositoryTagItem">
                        <TextBlock Margin="6,0,0,0"
                                   FontSize="11"
                                   Text="{Binding DisplayName}"
                                   Classes.primary="{Binding IsPrimary}"
                                   IsVisible="{Binding !IsPrimary}">
                          <TextBlock.Styles>
                            <Style Selector="TextBlock">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.FG2}"/>
                            </Style>
                            <Style Selector="TextBlock.primary">
                              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}"/>
                              <Setter Property="FontWeight" Value="Bold"/>
                            </Style>
                          </TextBlock.Styles>
                        </TextBlock>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Path Margin="2,0,0,0"
                        Width="12" Height="12"
                        Data="{StaticResource Icons.Error}"
                        Fill="Orange"
                        IsVisible="{Binding Node.IsInvalid}"/>
                </StackPanel>

                <ContentControl Grid.Column="1"
                                Margin="6,0,0,0"
                                Content="{Binding Node.Status, Mode=OneWay}"
                                IsVisible="{Binding Node.Status, Converter={x:Static ObjectConverters.NotEqual}}">
                  <ContentControl.DataTemplates>
                    <DataTemplate DataType="m:RepositoryStatus">
                      <StackPanel Orientation="Horizontal">
                        <Border Margin="3,0"
                                Height="18"
                                CornerRadius="9"
                                Padding="6,0"
                                Background="{DynamicResource Brush.FG1}"
                                VerticalAlignment="Center"
                                IsVisible="{Binding LocalChanges, Converter={x:Static c:IntConverters.IsGreaterThanZero}}">
                          <TextBlock Text="{Binding LocalChanges}"
                                     FontFamily="{DynamicResource Fonts.Monospace}"
                                     FontSize="11"
                                     Foreground="{DynamicResource Brush.Window}"/>
                        </Border>

                        <TextBlock Margin="3,0"
                                   Text="{Binding TrackingDescription}"
                                   FontFamily="{DynamicResource Fonts.Monospace}"
                                   FontSize="12"
                                   IsVisible="{Binding IsTrackingStatusVisible}"/>

                        <Border Margin="3,0,0,0"
                                BorderThickness="1"
                                BorderBrush="{DynamicResource Brush.FG2}"
                                Height="20"
                                CornerRadius="4"
                                Padding="4,0">
                          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Path Width="12" Height="12" Data="{StaticResource Icons.Branch}"/>
                            <TextBlock Margin="2,0,0,0" Text="{Binding CurrentBranch}" FontSize="12"/>
                          </StackPanel>
                        </Border>
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.DataTemplates>
                </ContentControl>
              </Grid>
            </Grid>
          </DataTemplate>
        </ListBox.DataTemplates>
      </ListBox>
    </Grid>

  </Grid>
</UserControl>
